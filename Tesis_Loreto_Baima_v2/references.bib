@article{TANG2025127322,
title = {Physics-Informed LSTM based dynamic model of heat exchanger and application on the thermal management system considering time delay},
journal = {International Journal of Heat and Mass Transfer},
volume = {250},
pages = {127322},
year = {2025},
issn = {0017-9310},
doi = {https://doi.org/10.1016/j.ijheatmasstransfer.2025.127322},
url = {https://www.sciencedirect.com/science/article/pii/S0017931025006611},
author = {Xue-bin Tang and Qi-biao Hong and Yu Liu and Bing-cheng Wang and Zheng Cui and Wei Shao},
keywords = {Dynamic simulation, Heat exchanger, Hybrid modeling, PI-LSTM, Thermal management systems},
abstract = {Data-driven modeling is widely used in the prediction of the dynamic response of heat exchangers, but its performance is restricted by the quality and quantity of the dataset. This paper proposes a dynamic modeling method for heat exchangers based on Physics-Informed Long Short-Term Memory Neural Networks (PI-LSTM), aiming to address the issue of accurate modeling in the face of scarce data. The method combines Physics-Informed Neural Networks (PINN) and Long Short-Term Memory Neural Networks (LSTM), where PINN incorporates the mechanism constraints based on the heat current method and LSTM captures temporal dependencies in the data. The experimental dataset from the thermal management system with an intermediate loop is used for modeling, and the validation results demonstrate that the Root Mean Square Error (RMSE) does not exceed 0.267 and the Mean Absolute Error (MAE) does not exceed 0.221. Compared with the typical LSTM models, the average prediction accuracy increases by 49.8 %. Additionally, a data-mechanism hybrid modelling method for the thermal management system is proposed by integrating the time delay between heat exchangers and the PI-LSTM models of the heat exchangers. Validation by the experimental data shows that the systematic model achieves the RMSE of no >0.269 and the MAE of no >0.213. The average prediction accuracy increases by 48.3 % over a typical LSTM model. It provides powerful solutions to improve the convergence of the mechanism models and to reduce the data dependency of data models.}
}
@article{UNTRAU2022275,
title = {Analysis and future perspectives for the application of Dynamic Real-Time Optimization to solar thermal plants: A review},
journal = {Solar Energy},
volume = {241},
pages = {275-291},
year = {2022},
issn = {0038-092X},
doi = {https://doi.org/10.1016/j.solener.2022.05.058},
url = {https://www.sciencedirect.com/science/article/pii/S0038092X22004042},
author = {Alix Untrau and Sabine Sochard and Frédéric Marias and Jean-Michel Reneaume and Galo A.C. {Le Roux} and Sylvain Serra},
keywords = {Solar thermal energy, Dynamic Real-Time Optimization, Optimal operation, Storage management},
abstract = {This review provides a deep analysis of the different methodologies to improve the operation of solar thermal plants based on mathematical optimization. The various schemes found in the literature to determine the optimal operational strategy are classified depending on two criteria: time dependence (static or dynamic) and with feedback or not from the plant (real-time or offline). This review shows that offline dynamic optimization is performed on solar thermal plants in research papers but highlights the lack of real-time optimization studies. The analysis work conducted in this review, based on studies of the operation of solar systems but also on process engineering research articles, shows that dynamic real-time optimization seems capable of handling the intermittency of the solar radiation and well suited to improve the operation of a solar thermal plant. Indeed, the daily and seasonal variations of weather and heat demand associated with the uncertainty of their forecasts make the operation of such systems very challenging. This paper details the different ways to implement Dynamic Real-Time Optimization, and the possible improvements to the classical scheme. Perspectives on the application of Dynamic Real-Time Optimization in association with a planning phase to plan a smart use of storage are described. Although it has not been studied in depth in the literature, the Dynamic Real-Time Optimization of a solar thermal plant including storage should be investigated in order to maximize the benefits from the heat sold, extend the time period where the heat demand is met and reduce the consumption of back up fossil fuels.}
}

